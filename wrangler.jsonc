{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eolietech",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Only API traffic invokes (and bills) the Worker; pages are served as static assets.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eolietech",
      // Created with `npx wrangler d1 create eolietech --jurisdiction eu` (EU jurisdiction, region EEUR).
      // Local dev / tests use a local copy and never touch it.
      "database_id": "0fd3e95d-11e5-4f6f-a314-9a57424078e1",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "RL_WAITLIST", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    // Site key of the "eolietech-waitlist" Turnstile widget (eolietech.com). Unused by code today: the form reads
    // the build-time PUBLIC_TURNSTILE_SITE_KEY (src/site.config.ts).
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFaUkgrbhRsWTSor"
  }
  // Secrets (wrangler secret put): TURNSTILE_SECRET. Locally: copy .dev.vars.example to .dev.vars.
}
