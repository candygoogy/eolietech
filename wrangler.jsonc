{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eolietech",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Only API traffic invokes (and bills) the Worker; pages are served as static assets.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eolietech",
      // Placeholder. At launch create the real database in the EU jurisdiction:
      //   npx wrangler d1 create eolietech --jurisdiction eu
      // and paste its id here. Local dev / tests do not need a real id.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "RL_WAITLIST", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    // Cloudflare's official Turnstile test site key (always passes). Replace at launch.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  }
  // Secrets (wrangler secret put): TURNSTILE_SECRET. Locally: copy .dev.vars.example to .dev.vars.
}
