---
/**
 * Eolietech logo: the mark (a tiny Stromboli postcard: sulphur sky, basalt cone, ember, sea) plus the
 * Archivo wordmark, outlined so it needs no font. The mark is a printed object, so it keeps its colours
 * in both themes (tokens, styles below); the wordmark takes currentColor and follows the theme.
 * Same tile as public/favicon.svg; static copies: public/logo.svg, public/logo-dark.svg.
 */
interface Props {
  /** Accessible name. Omit when the surrounding link already names it. */
  label?: string;
  class?: string;
  /** The mark alone, without the wordmark (the stamp on the footer postcard). */
  mark?: boolean;
}
const { label, class: className, mark = false } = Astro.props;
/* Mark only: the 64-unit tile scaled by 15 (x 0..960, y -823..137). */
const viewBox = mark ? "0 -823 960 960" : "0 -823 6150 975";
/* The tile has rounded corners; the mark alone is printed full-bleed on the footer stamp, so it is square. */
const sky = mark ? "M0 0h64v46H0z" : "M0 46V7a7 7 0 0 1 7-7h50a7 7 0 0 1 7 7v39z";
const sea = mark ? "M0 44h64v20H0z" : "M0 44h64v13a7 7 0 0 1-7 7H7a7 7 0 0 1-7-7z";
---

<svg
  class:list={["logo", { "logo--mark": mark }, className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox={viewBox}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  <g transform="translate(0 -823) scale(15)">
    <path class="logo__sky" d={sky}></path>
    <path class="logo__peak" d="M5 47 26.5 16h11L59 47z"></path>
    <path class="logo__water" d={sea}></path>
    <circle class="logo__fire" cx="32" cy="8.5" r="4"></circle>
  </g>
