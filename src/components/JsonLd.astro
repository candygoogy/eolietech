---
/**
 * A schema.org JSON-LD data block (builders: src/lib/structured-data.ts). Put it in Base's head:
 * <JsonLd slot="head" data={...} />. `is:inline` keeps Astro from bundling it; a data block is never
 * executed, so the CSP (no 'unsafe-inline') does not apply to it. The JSON is escaped for <script>.
 */
import { serializeJsonLd } from "../lib/structured-data";

interface Props {
  data: unknown;
}
---

<script type="application/ld+json" is:inline set:html={serializeJsonLd(Astro.props.data)} />
