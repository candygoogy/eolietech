---
/**
 * The close of every page: the back of a postcard. A paper card with an airmail edge (sea and
 * sulphur stripes) and a divider down the middle. Left, the message: a handwritten sign-off (SVG
 * strokes, Handwriting.astro), one line, and where it was made. Right, the address side: a
 * perforated stamp with the logo mark and a postmark over it, the site links written on the address
 * lines, and the copyright. Tool pages get a compact card so the tool stays the page.
 * Styles: global.css, "site footer".
 */
import Handwriting from "./Handwriting.astro";
import Logo from "./Logo.astro";
import Stamp from "./Stamp.astro";
import { localePath, t } from "../i18n";
import { siteConfig } from "../site.config";
import type { Locale } from "../tools/types";

interface Props {
  locale: Locale;
  compact?: boolean;
}

const { locale, compact = false } = Astro.props;
const year = new Date().getFullYear();
const links = [
  { href: localePath(locale, "security"), label: t(locale, "footer.security") },
  { href: localePath(locale, "privacy"), label: t(locale, "footer.privacy") },
  { href: localePath(locale, "terms"), label: t(locale, "footer.terms") },
  { href: siteConfig.sourceUrl, label: t(locale, "footer.source") },
];
---

<footer class:list={["site-footer", { "site-footer--compact": compact }]}>
  <div class="site-footer__inner">
    <div class="postcard-back">
      <div class="postcard-back__message">
        <Handwriting
          class="postcard-back__signoff"
          text={t(locale, "footer.signoff")}
          label={t(locale, "footer.signoff.label")}
          lang="it"
        />
        <p class="postcard-back__line">{t(locale, "footer.line")}</p>
        <p class="postcard-back__made">{t(locale, "footer.made")}</p>
      </div>
      <div class="postcard-back__address">
        <div class="postcard-back__corner" aria-hidden="true">
          <span class="postage postage--mark">
            <span class="postage__face"><Logo mark /></span>
          </span>
          <Stamp
            class="postcard-back__postmark"
            as="span"
            shape="circle"
            ink="sea"
            tilt={-4}
            text={t(locale, "footer.postmark")}
            sub={t(locale, "footer.postmark.place")}
          />
        </div>
        <nav class="postcard-back__nav" aria-label={t(locale, "footer.label")}>
          <ul>
            {
              links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <p class="postcard-back__legal">{t(locale, "footer.copyright", { year })}</p>
      </div>
    </div>
  </div>
</footer>
