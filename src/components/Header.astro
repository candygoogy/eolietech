---
import Logo from "./Logo.astro";
import { localePath, t } from "../i18n";
import { pagePath } from "../i18n/routes";
import { siteConfig } from "../site.config";
import { LOCALES, type Locale } from "../tools/types";

interface Props {
  locale: Locale;
  /** This page in each locale (Base.astro). Locales without a translation link to their home page. */
  alternates?: { locale: Locale; path: string }[];
}

/** Each language named in itself, so a reader finds theirs whatever the page's language. */
const ENDONYMS: Record<Locale, string> = { en: "English", it: "Italiano" };

const { locale, alternates = [] } = Astro.props;
const current = Astro.url.pathname;
const links = siteConfig.nav.map((item) => {
  const href = pagePath(locale, item.page);
  return { href, label: t(locale, item.key), current: current === href || current.startsWith(href) };
});
/** Every language as its two-letter code; the current one is marked, the others link to this page in them. */
const languages = LOCALES.map((l) => ({
  locale: l,
  code: l.toUpperCase(),
  name: ENDONYMS[l],
  current: l === locale,
  href: alternates.find((a) => a.locale === l)?.path ?? localePath(l),
}));
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href={localePath(locale)} aria-label={t(locale, "nav.homeLabel")}>
      <Logo />
    </a>
    <nav class="site-nav" aria-label={t(locale, "nav.label")}>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={link.current ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="site-lang" role="group" aria-label={t(locale, "nav.language")}>
      {
        languages.map((lang, i) => (
          <>
            {i > 0 && (
              <span class="site-lang__sep" aria-hidden="true">
                /
              </span>
            )}
            {lang.current ? (
              <span class="site-lang__code" aria-current="true" lang={lang.locale}>
                <span aria-hidden="true">{lang.code}</span>
                <span class="visually-hidden">{lang.name}</span>
              </span>
            ) : (
              <a class="site-lang__code" href={lang.href} hreflang={lang.locale} lang={lang.locale}>
                <span aria-hidden="true">{lang.code}</span>
                <span class="visually-hidden">{lang.name}</span>
              </a>
            )}
          </>
        ))
      }
    </p>
  </div>
</header>
