---
/**
 * A real tool mounted outside its own page (the home desk runs the image compressor).
 * Renders the same [data-tool-root] contract as src/pages/[tool].astro, with the same strings
 * (shared `tool.*` site strings, then the tool's own `ui:` frontmatter), so src/lib/tool-mount.ts
 * mounts it unchanged. The tool's client chunk loads when the page calls mountTools(); its codecs
 * load in a worker only when a file is added (WorkerPool creates workers on the first job).
 * The loading shell reserves the tool's measured height (tool.css, --tool-shell), so nothing shifts.
 */
import { getEntry } from "astro:content";
import { getDictionary, t } from "../i18n";
import { contentEntryId } from "../tools/content-files";
import { getTool } from "../tools/registry";
import type { Locale } from "../tools/types";

interface Props {
  locale: Locale;
  toolId: string;
}

const { locale, toolId } = Astro.props;
const tool = getTool(toolId);
if (!tool) throw new Error(`LiveTool: unknown tool ${toolId}`);
const entry = await getEntry("tools", contentEntryId(toolId, locale));
if (!entry) throw new Error(`LiveTool: missing content for ${toolId} (${locale})`);

const siteToolStrings = Object.fromEntries(Object.entries(getDictionary(locale)).filter(([k]) => k.startsWith("tool.")));
const strings = { ...siteToolStrings, ...entry.data.ui };
---

<div class="tool-panel">
  <div
    data-tool-root
    data-tool-id={tool.id}
    data-variant-id=""
    data-locale={locale}
    data-preset="{}"
    data-limits={JSON.stringify(tool.limits.free)}
    data-strings={JSON.stringify(strings)}
  >
    <div class="tool-shell__well">
      <p class="tool-shell__status">{t(locale, "tool.loading")}</p>
    </div>
  </div>
  <noscript><p class="tool-note">{t(locale, "tool.noscript")}</p></noscript>
</div>

<script>
  import { mountTools } from "../lib/tool-mount";
  void mountTools();
</script>
