---
/**
 * A hand-drawn arrow for handwritten notes. Decorative (aria-hidden); it takes the note's ink
 * (currentColor). Direction and flip are set per use in CSS (rotate / scale on .hand__arrow).
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={["hand__arrow", className]} viewBox="0 0 44 40" aria-hidden="true" focusable="false">
  <path d="M4 5c13 1 24 9 29 27"></path>
  <path d="M25 26.5l8 6.5 3.5-9.5"></path>
</svg>
