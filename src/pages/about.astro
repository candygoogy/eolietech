---
import Base from "../layouts/Base.astro";
import SeaContours from "../components/SeaContours.astro";
import Stamp from "../components/Stamp.astro";
import { localePath, t } from "../i18n";
import type { Locale } from "../tools/types";

const locale: Locale = "en";
const sections = [
  { id: "origin", paragraphs: ["about.origin.p1", "about.origin.p2"] },
  { id: "privacy", paragraphs: ["about.privacy.p1", "about.privacy.p2"] },
  { id: "open", paragraphs: ["about.open.p1", "about.open.p2"] },
  { id: "money", paragraphs: ["about.money.p1"] },
];
/** The site's real colours: the two neutral grounds and the two island colours. */
const palette = ["white", "black", "sea", "ember"];
---

<Base locale={locale} title={t(locale, "about.title")} description={t(locale, "about.description")} path={localePath(locale, "about")}>
  <header class="page-head container">
    <h1>{t(locale, "about.h1")}</h1>
    <p class="lede">{t(locale, "about.lede")}</p>
    <Stamp class="page-head__stamp" text={t(locale, "about.stamp")} sub={t(locale, "about.stamp.sub")} shape="circle" ink="ochre" tilt={-4} land="load" />
    <SeaContours />
  </header>

  <section class="container palette-strip" aria-labelledby="palette-h">
    <h2 id="palette-h" class="visually-hidden">{t(locale, "about.palette.label")}</h2>
    <ul class="palette">
      {
        palette.map((name) => (
          <li class={`palette__${name}`}>
            <span class="palette__name">{t(locale, `about.palette.${name}`)}</span>
            <span class="palette__use">{t(locale, `about.palette.${name}.use`)}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="container about">
    {
      sections.map((s) => (
        <section class="about__section" aria-labelledby={`about-${s.id}`}>
          <h2 id={`about-${s.id}`}>{t(locale, `about.${s.id}.h2`)}</h2>
          <div class="about__text">
            {s.paragraphs.map((key) => (
              <p>{t(locale, key)}</p>
            ))}
          </div>
        </section>
      ))
    }
    <div class="about__section">
      <ul class="links about__text">
        <li><a href={localePath(locale, "security")}>{t(locale, "about.cta.security")}</a></li>
        <li><a href={localePath(locale, "pricing")}>{t(locale, "about.cta.pricing")}</a></li>
      </ul>
    </div>
  </div>
</Base>
