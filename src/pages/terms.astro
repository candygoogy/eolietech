---
/**
 * Terms of use. Same shape as /security/ and /privacy/: page head, then a table of contents beside
 * the text. The contact address is the one the privacy policy uses (privacy.email in en.json).
 */
import Base from "../layouts/Base.astro";
import SeaContours from "../components/SeaContours.astro";
import Stamp from "../components/Stamp.astro";
import { localePath, t } from "../i18n";
import { siteConfig } from "../site.config";
import type { Locale } from "../tools/types";

const locale: Locale = "en";
const email = t(locale, "privacy.email");
const toc = ["about", "free", "files", "asis", "liability", "use", "code", "law", "changes", "contact"];
const misuse = ["attack", "load", "waitlist", "illegal"];
---

<Base locale={locale} title={t(locale, "terms.title")} description={t(locale, "terms.description")} path={localePath(locale, "terms")}>
  <header class="page-head container">
    <h1>{t(locale, "terms.h1")}</h1>
    <p class="lede">{t(locale, "terms.lede")}</p>
    <Stamp class="page-head__stamp" text={t(locale, "terms.stamp")} ink="ochre" tilt={-2} land="load" />
    <SeaContours />
  </header>

  <div class="container doc">
    <nav class="doc__aside" aria-labelledby="toc-h">
      <h2 id="toc-h">{t(locale, "terms.toc")}</h2>
      <ol>
        {
          toc.map((id) => (
            <li>
              <a href={`#${id}`}>{t(locale, `terms.${id}.h2`)}</a>
            </li>
          ))
        }
      </ol>
      <p class="doc__updated">{t(locale, "terms.updated")}</p>
    </nav>

    <div class="doc__body">
      <section aria-labelledby="about">
        <h2 id="about">{t(locale, "terms.about.h2")}</h2>
        <p>{t(locale, "terms.about.p1")}</p>
      </section>

      <section aria-labelledby="free">
        <h2 id="free">{t(locale, "terms.free.h2")}</h2>
        <p>{t(locale, "terms.free.p1")}</p>
        <p>{t(locale, "terms.free.p2")}</p>
        <ul class="links">
          <li><a href={localePath(locale, "privacy")}>{t(locale, "terms.free.link")}</a></li>
        </ul>
      </section>

      <section aria-labelledby="files">
        <h2 id="files">{t(locale, "terms.files.h2")}</h2>
        <p>{t(locale, "terms.files.p1")}</p>
        <p>{t(locale, "terms.files.p2")}</p>
      </section>

      <section aria-labelledby="asis">
        <h2 id="asis">{t(locale, "terms.asis.h2")}</h2>
        <p>{t(locale, "terms.asis.p1")}</p>
        <p>{t(locale, "terms.asis.p2")}</p>
        <p>{t(locale, "terms.asis.p3")}</p>
      </section>

      <section aria-labelledby="liability">
        <h2 id="liability">{t(locale, "terms.liability.h2")}</h2>
        <p>{t(locale, "terms.liability.p1")}</p>
        <p>{t(locale, "terms.liability.p2")}</p>
      </section>

      <section aria-labelledby="use">
        <h2 id="use">{t(locale, "terms.use.h2")}</h2>
        <p>{t(locale, "terms.use.p1")}</p>
        <ul>
          {misuse.map((k) => <li>{t(locale, `terms.use.${k}`)}</li>)}
        </ul>
        <p>{t(locale, "terms.use.p2")}</p>
      </section>

      <section aria-labelledby="code">
        <h2 id="code">{t(locale, "terms.code.h2")}</h2>
        <p>{t(locale, "terms.code.p1")}</p>
        <ul class="links">
          <li><a href={siteConfig.sourceUrl}>{t(locale, "terms.code.source")}</a></li>
          <li><a href={siteConfig.licenseUrl}>{t(locale, "terms.code.license")}</a></li>
        </ul>
        <p>{t(locale, "terms.code.p2")}</p>
        <p>{t(locale, "terms.code.p3")}</p>
      </section>

      <section aria-labelledby="law">
        <h2 id="law">{t(locale, "terms.law.h2")}</h2>
        <p>{t(locale, "terms.law.p1")}</p>
      </section>

      <section aria-labelledby="changes">
        <h2 id="changes">{t(locale, "terms.changes.h2")}</h2>
        <p>{t(locale, "terms.changes.p1")}</p>
      </section>

      <section aria-labelledby="contact">
        <h2 id="contact">{t(locale, "terms.contact.h2")}</h2>
        <p>{t(locale, "terms.contact.p1")}</p>
        <ul class="links">
          <li><a href={`mailto:${email}`}>{email}</a></li>
        </ul>
      </section>
    </div>
  </div>
</Base>
