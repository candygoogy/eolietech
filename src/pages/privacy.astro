---
/**
 * Privacy policy. Every statement here is backed by code: the waitlist columns
 * (migrations/0001_waitlist.sql, src/worker/routes/waitlist.ts), the CSP (public/_headers), the model
 * cache (src/tools/ai-shared/model-files.ts, Cache API only) and the Turnstile loader (WaitlistForm.astro,
 * /pricing/ only). Change the copy in en.json when any of those change. If the waitlist's purpose or the
 * stored fields change, bump CONSENT_VERSION in waitlist.ts too.
 */
import Base from "../layouts/Base.astro";
import SeaContours from "../components/SeaContours.astro";
import Stamp from "../components/Stamp.astro";
import { localePath, t } from "../i18n";
import type { Locale } from "../tools/types";

const locale: Locale = "en";
const email = t(locale, "privacy.email");
const mailto = `mailto:${email}`;
const toc = ["short", "who", "files", "browser", "waitlist", "turnstile", "hosting", "email", "never", "transfers", "rights", "changes"];
const summary = ["files", "cookies", "tracking", "waitlist"];
const kept = ["email", "day", "consent"];
const rights = ["access", "rectify", "erase", "restrict", "object", "port", "withdraw"];
---

<Base locale={locale} title={t(locale, "privacy.title")} description={t(locale, "privacy.description")} path={localePath(locale, "privacy")}>
  <header class="page-head container">
    <h1>{t(locale, "privacy.h1")}</h1>
    <p class="lede">{t(locale, "privacy.lede")}</p>
    <Stamp class="page-head__stamp" text={t(locale, "privacy.stamp")} ink="ember" tilt={3} land="load" />
    <SeaContours />
  </header>

  <div class="container doc">
    <nav class="doc__aside" aria-labelledby="toc-h">
      <h2 id="toc-h">{t(locale, "privacy.toc")}</h2>
      <ol>
        {
          toc.map((id) => (
            <li>
              <a href={`#${id}`}>{t(locale, `privacy.${id}.h2`)}</a>
            </li>
          ))
        }
      </ol>
      <p class="doc__updated">{t(locale, "privacy.updated")}</p>
    </nav>

    <div class="doc__body">
      <section aria-labelledby="short">
        <h2 id="short">{t(locale, "privacy.short.h2")}</h2>
        <dl class="ledger">
          {
            summary.map((k) => (
              <div>
                <dt>{t(locale, `privacy.short.${k}`)}</dt>
                <dd>{t(locale, `privacy.short.${k}.value`)}</dd>
              </div>
            ))
          }
          <div>
            <dt>{t(locale, "privacy.short.contact")}</dt>
            <dd><a href={mailto}>{email}</a></dd>
          </div>
        </dl>
      </section>

      <section aria-labelledby="who">
        <h2 id="who">{t(locale, "privacy.who.h2")}</h2>
        <p>{t(locale, "privacy.who.p1")}</p>
        <p>{t(locale, "privacy.who.p2")}</p>
        <ul class="links">
          <li><a href={mailto}>{email}</a></li>
        </ul>
      </section>

      <section aria-labelledby="files">
        <h2 id="files">{t(locale, "privacy.files.h2")}</h2>
        <p>{t(locale, "privacy.files.p1")}</p>
        <p>{t(locale, "privacy.files.p2")}</p>
        <ul class="links">
          <li><a href={localePath(locale, "security")}>{t(locale, "privacy.files.link")}</a></li>
        </ul>
      </section>

      <section aria-labelledby="browser">
        <h2 id="browser">{t(locale, "privacy.browser.h2")}</h2>
        <p>{t(locale, "privacy.browser.p1")}</p>
        <p>{t(locale, "privacy.browser.p2")}</p>
        <p>{t(locale, "privacy.browser.p3")}</p>
      </section>

      <section aria-labelledby="waitlist">
        <h2 id="waitlist">{t(locale, "privacy.waitlist.h2")}</h2>
        <p>{t(locale, "privacy.waitlist.p1")}</p>
        <ul>
          {kept.map((k) => <li>{t(locale, `privacy.waitlist.kept.${k}`)}</li>)}
        </ul>
        <p>{t(locale, "privacy.waitlist.p2")}</p>
        <p>{t(locale, "privacy.waitlist.p3")}</p>
        <p>{t(locale, "privacy.waitlist.p4")}</p>
        <p>{t(locale, "privacy.waitlist.p5")}</p>
        <p>{t(locale, "privacy.waitlist.p6")}</p>
        <p>{t(locale, "privacy.waitlist.p7")}</p>
        <ul class="links">
          <li><a href={mailto}>{email}</a></li>
        </ul>
      </section>

      <section aria-labelledby="turnstile">
        <h2 id="turnstile">{t(locale, "privacy.turnstile.h2")}</h2>
        <p>{t(locale, "privacy.turnstile.p1")}</p>
        <p>{t(locale, "privacy.turnstile.p2")}</p>
        <p>{t(locale, "privacy.turnstile.p3")}</p>
        <p>{t(locale, "privacy.turnstile.p4")}</p>
        <ul class="links">
          <li><a href="https://www.cloudflare.com/turnstile-privacy-policy/">{t(locale, "privacy.turnstile.link")}</a></li>
        </ul>
      </section>

      <section aria-labelledby="hosting">
        <h2 id="hosting">{t(locale, "privacy.hosting.h2")}</h2>
        <p>{t(locale, "privacy.hosting.p1")}</p>
        <p>{t(locale, "privacy.hosting.p2")}</p>
        <p>{t(locale, "privacy.hosting.p3")}</p>
        <ul class="links">
          <li><a href="https://www.cloudflare.com/privacypolicy/">{t(locale, "privacy.hosting.link")}</a></li>
        </ul>
      </section>

      <section aria-labelledby="email">
        <h2 id="email">{t(locale, "privacy.email.h2")}</h2>
        <p>{t(locale, "privacy.email.p1")}</p>
        <p>{t(locale, "privacy.email.p2")}</p>
        <p>{t(locale, "privacy.email.p3")}</p>
        <p>{t(locale, "privacy.email.p4")}</p>
        <ul class="links">
          <li><a href="https://www.fastmail.com/policies/privacy/">{t(locale, "privacy.email.link")}</a></li>
        </ul>
      </section>

      <section aria-labelledby="never">
        <h2 id="never">{t(locale, "privacy.never.h2")}</h2>
        <ul class="never">
          {["1", "2", "3", "4", "5"].map((n) => <li>{t(locale, `privacy.never.${n}`)}</li>)}
        </ul>
      </section>

      <section aria-labelledby="transfers">
        <h2 id="transfers">{t(locale, "privacy.transfers.h2")}</h2>
        <p>{t(locale, "privacy.transfers.p1")}</p>
        <p>{t(locale, "privacy.transfers.p2")}</p>
        <p>{t(locale, "privacy.transfers.p3")}</p>
      </section>

      <section aria-labelledby="rights">
        <h2 id="rights">{t(locale, "privacy.rights.h2")}</h2>
        <p>{t(locale, "privacy.rights.p1")}</p>
        <ul>
          {rights.map((r) => <li>{t(locale, `privacy.rights.${r}`)}</li>)}
        </ul>
        <p>{t(locale, "privacy.rights.p2")}</p>
        <ul class="links">
          <li><a href={mailto}>{email}</a></li>
        </ul>
        <p>{t(locale, "privacy.rights.p3")}</p>
        <ul class="links">
          <li><a href="https://www.garanteprivacy.it/" hreflang="it">{t(locale, "privacy.rights.link")}</a></li>
        </ul>
      </section>

      <section aria-labelledby="changes">
        <h2 id="changes">{t(locale, "privacy.changes.h2")}</h2>
        <p>{t(locale, "privacy.changes.p1")}</p>
      </section>
    </div>
  </div>
</Base>
