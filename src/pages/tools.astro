---
import Base from "../layouts/Base.astro";
import ToolIndex from "../components/ToolIndex.astro";
import { localePath, t } from "../i18n";
import type { Locale } from "../tools/types";

const locale: Locale = "en";
---

<Base locale={locale} title={t(locale, "tools.title")} description={t(locale, "tools.description")} path={localePath(locale, "tools")}>
  <header class="page-head container">
    <h1>{t(locale, "tools.h1")}</h1>
    <p class="lede">{t(locale, "tools.lede")}</p>
  </header>
  <div class="container">
    <ToolIndex locale={locale} level={2} detailed />
  </div>
</Base>
