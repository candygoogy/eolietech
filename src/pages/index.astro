---
/**
 * Home: "postcards that never get posted". A desk over the sea-depth contours of the islands, with
 * the visitor's kinds of files lying on it (Desk.astro). The postcard is the real image compressor:
 * drop a photo on it (src/scripts/desk-post.ts). Then the tools, the formats as a sheet of postage
 * stamps, how it works, the checks with a live count of the other servers this page has talked to
 * (src/scripts/net-counter.ts), the maker. Rubber stamps (Stamp.astro) annotate; the postcard back
 * is the Footer.
 */
import Base from "../layouts/Base.astro";
import Desk from "../components/Desk.astro";
import HowItWorks from "../components/HowItWorks.astro";
import SeaContours from "../components/SeaContours.astro";
import Stamp from "../components/Stamp.astro";
import ToolIndex from "../components/ToolIndex.astro";
import { directive } from "../components/csp";
import { localePath, t } from "../i18n";
import { getTool, publishedTools } from "../tools/registry";
import type { Category, Locale } from "../tools/types";
import "../styles/desk-post.css";

const locale: Locale = "en";
const facts = ["free", "open", "offline"];
const checks = ["network", "csp", "offline", "code"];
const connectSrc = directive("connect-src");

/**
 * The stamp sheet: formats the tools really accept, filed under the tools that take them. Checked
 * against the accept lists: image-shared/formats.ts (JPG, PNG, WebP, AVIF; HEIC for heic-to-jpg),
 * background-remover/client.ts (also GIF, BMP), the PDF tools (PDF), audio-transcribe/client.ts and
 * its content page (MP3, M4A, WAV, OGG, FLAC, and the sound in MP4 and WebM video). Names as
 * written (data, not copy). A tool is linked only when its page is published.
 */
const sheet: { category: Category; fill: "sulphur" | "ember" | "sea"; toolIds: string[]; formats: string[]; video?: string[] }[] = [
  {
    category: "image",
    fill: "sulphur",
    toolIds: ["image-compress", "heic-to-jpg", "background-remover"],
    formats: ["JPG", "PNG", "WebP", "AVIF", "HEIC", "GIF", "BMP"],
  },
  { category: "pdf", fill: "ember", toolIds: ["pdf-merge", "pdf-split", "pdf-organize", "pdf-compress"], formats: ["PDF"] },
  {
    category: "audio",
    fill: "sea",
    toolIds: ["audio-transcribe"],
    formats: ["MP3", "M4A", "WAV", "OGG", "FLAC", "MP4", "WebM"],
    video: ["MP4", "WebM"],
  },
];
const published = new Set(publishedTools().map((tool) => tool.id));
const sheetRows = sheet.map((row) => ({
  ...row,
  tools: row.toolIds.flatMap((id) => {
    const slug = getTool(id)?.slug[locale];
    return published.has(id) && slug ? [{ id, name: t(locale, `tools.${id}.name`), href: localePath(locale, slug) }] : [];
  }),
}));
const formatCount = sheet.reduce((n, row) => n + row.formats.length, 0);
---

<Base locale={locale} title={t(locale, "home.title")} description={t(locale, "site.description")} path="/">
  <div class="desk">
    <SeaContours />
    <section class="desk__hero container" aria-labelledby="hero-h">
      <h1 id="hero-h" class="desk__title">{t(locale, "home.h1")}</h1>
      <div class="desk__body">
        <div class="desk__intro">
          <p class="lede desk__lede">{t(locale, "home.lede")}</p>
          <div class="desk__actions">
            <a class="btn btn--primary desk__cta" href="#postcard">{t(locale, "home.cta.try")}</a>
            <a class="link-strong" href="#tools">{t(locale, "home.cta.tools")}</a>
          </div>
        </div>
        <Desk locale={locale} />
      </div>
    </section>

    <ul class="facts container" aria-label={t(locale, "home.facts.label")} data-reveal data-reveal-stagger>
      {
        facts.map((id) => (
          <li>{t(locale, `home.fact.${id}`)}</li>
        ))
      }
    </ul>
  </div>

  <section id="tools" class="section container" aria-labelledby="tools-h">
    <div class="section__head section__head--noted" data-reveal>
      <h2 id="tools-h">{t(locale, "home.tools.h2")}</h2>
      <p>{t(locale, "home.tools.lede")}</p>
      <Stamp class="section__note" text={t(locale, "home.tools.stamp")} ink="ochre" tilt={-3} />
    </div>
    <ToolIndex locale={locale} level={3} reveal />
    <p class="section__more"><a class="link-strong" href={localePath(locale, "tools")}>{t(locale, "home.tools.all")}</a></p>
  </section>

  <section class="section container formats" aria-labelledby="formats-h">
    <div class="section__head formats__head" data-reveal>
      <h2 id="formats-h">{t(locale, "home.formats.h2")}</h2>
      <p>{t(locale, "home.formats.lede")}</p>
    </div>
    <div class="sheet" data-reveal data-reveal-stagger>
      <p class="sheet__selvage" aria-hidden="true">{t(locale, "home.formats.selvage", { count: formatCount })}</p>
      {
        sheetRows.map((row) => (
          <div class="sheet__row">
            <div class="sheet__label">
              <h3 id={`formats-${row.category}`}>{t(locale, `tools.category.${row.category}`)}</h3>
              {row.tools.length > 0 && (
                <p>
                  {t(locale, "home.formats.by")}{" "}
                  {row.tools.map((tool, i) => (
                    <>
                      {i > 0 && ", "}
                      <a href={tool.href}>{tool.name}</a>
                    </>
                  ))}
                </p>
              )}
            </div>
            <ul class="sheet__stamps" aria-labelledby={`formats-${row.category}`}>
              {row.formats.map((name) => {
                const video = row.video?.includes(name);
                return (
                  <li class="postage" data-fill={video ? "neutral" : row.fill}>
                    <span class="postage__face">
                      <span class="postage__value" aria-hidden="true">{t(locale, "home.formats.value")}</span>
                      <span class="postage__name">{name}</span>
                      {video && <span class="postage__kind">{t(locale, "home.formats.video")}</span>}
                    </span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <HowItWorks locale={locale} />

  <section class="verify" aria-labelledby="verify-h">
    <div class="container verify__inner">
      <div class="verify__title" data-reveal>
        <h2 id="verify-h">{t(locale, "home.verify.h2")}</h2>
      </div>
      <div class="verify__intro" data-reveal>
        <p>{t(locale, "home.verify.lede")}</p>
        {
          connectSrc && (
            <div class="verify__proof">
              <pre class="verify__policy"><code>{connectSrc}</code></pre>
              <Stamp class="verify__stamp" text={t(locale, "home.verify.stamp")} ink="on-dark" tilt={-2} />
            </div>
          )
        }
        <div
          class="counter"
          data-counter
          data-show={t(locale, "home.counter.show")}
          data-hide={t(locale, "home.counter.hide")}
          data-none={t(locale, "home.counter.none")}
          data-list-label={t(locale, "home.counter.listLabel")}
          hidden
        >
          <button type="button" class="counter__toggle" aria-expanded="false" aria-controls="counter-panel">
            <span class="counter__label">{t(locale, "home.counter.label")}</span>
            <span class="counter__n">0</span>
            <span class="counter__more">{t(locale, "home.counter.show")}</span>
          </button>
          <div class="counter__panel" id="counter-panel" hidden></div>
          <p class="counter__how">{t(locale, "home.counter.how")}</p>
        </div>
        <a class="verify__more link-strong" href={localePath(locale, "security")}>{t(locale, "home.verify.more")}</a>
      </div>
      <ul class="verify__list" data-reveal data-reveal-stagger>
        {
          checks.map((id) => (
            <li>
              <h3>{t(locale, `home.verify.${id}.title`)}</h3>
              <p>{t(locale, `home.verify.${id}.body`)}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section container closing">
    <div class="closing__head" data-reveal>
      <h2 class="closing__title">{t(locale, "home.maker.h2")}</h2>
    </div>
    <div class="closing__row" data-reveal data-reveal-stagger>
      <div class="closing__maker">
        <p>{t(locale, "home.maker.body")}</p>
        <p><a class="link-strong" href={localePath(locale, "about")}>{t(locale, "home.maker.link")}</a></p>
      </div>
      <div class="closing__pro">
        <h2>{t(locale, "home.pro.h2")}</h2>
        <p>{t(locale, "home.pro.body")}</p>
        <a class="btn" href={`${localePath(locale, "pricing")}#waitlist`}>{t(locale, "home.pro.link")}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Bundled to external modules (assetsInlineLimit: 0), so the CSP stays free of inline scripts.
  import "../scripts/desk-post";
  import "../scripts/net-counter";
</script>
