---
/**
 * A general guide: how to tell whether any online file tool uploads your files. Not about Eolietech
 * itself (that is /security/), so it names no other service and makes no claim about one.
 */
import Base from "../layouts/Base.astro";
import SeaContours from "../components/SeaContours.astro";
import Stamp from "../components/Stamp.astro";
import { localePath, t } from "../i18n";
import { pageAlternates, pagePath } from "../i18n/routes";
import type { Locale } from "../tools/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const toc = ["two", "network", "offline", "csp", "limits", "summary", "ours"];
const networkSteps = ["s1", "s2", "s3", "s4", "s5"];
const offlineSteps = ["s1", "s2", "s3"];
const limits = ["1", "2", "3"];
const summary = ["network", "offline", "csp", "code"];
const curl = "curl -sI https://example.com | grep -i content-security-policy";
---

<Base locale={locale} title={t(locale, "guide.title")} description={t(locale, "guide.description")} path={pagePath(locale, "guide")} alternates={pageAlternates("guide")}>
  <header class="page-head container">
    <h1>{t(locale, "guide.h1")}</h1>
    <p class="lede">{t(locale, "guide.lede")}</p>
    <Stamp class="page-head__stamp" text={t(locale, "guide.stamp")} ink="sea" tilt={2} land="load" />
    <SeaContours />
  </header>

  <div class="container doc">
    <nav class="doc__aside" aria-labelledby="toc-h">
      <h2 id="toc-h">{t(locale, "guide.toc")}</h2>
      <ol>
        {
          toc.map((id) => (
            <li>
              <a href={`#${id}`}>{t(locale, `guide.${id}.h2`)}</a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="doc__body">
      <section aria-labelledby="two">
        <h2 id="two">{t(locale, "guide.two.h2")}</h2>
        <p>{t(locale, "guide.two.p1")}</p>
        <p>{t(locale, "guide.two.p2")}</p>
        <p>{t(locale, "guide.two.p3")}</p>
      </section>

      <section aria-labelledby="network">
        <h2 id="network">{t(locale, "guide.network.h2")}</h2>
        <p>{t(locale, "guide.network.p1")}</p>
        <ol>
          {networkSteps.map((s) => <li>{t(locale, `guide.network.${s}`)}</li>)}
        </ol>
        <p>{t(locale, "guide.network.p2")}</p>
      </section>

      <section aria-labelledby="offline">
        <h2 id="offline">{t(locale, "guide.offline.h2")}</h2>
        <ol>
          {offlineSteps.map((s) => <li>{t(locale, `guide.offline.${s}`)}</li>)}
        </ol>
        <p class="note">{t(locale, "guide.offline.caveat")}</p>
      </section>

      <section aria-labelledby="csp">
        <h2 id="csp">{t(locale, "guide.csp.h2")}</h2>
        <p>{t(locale, "guide.csp.p1")}</p>
        <p>{t(locale, "guide.csp.p2")}</p>
        <pre class="code-block"><code>{curl}</code></pre>
        <p>{t(locale, "guide.csp.p3")}</p>
        <p class="note">{t(locale, "guide.csp.caveat")}</p>
      </section>

      <section aria-labelledby="limits">
        <h2 id="limits">{t(locale, "guide.limits.h2")}</h2>
        <ul>
          {limits.map((n) => <li>{t(locale, `guide.limits.${n}`)}</li>)}
        </ul>
      </section>

      <section aria-labelledby="summary">
        <h2 id="summary">{t(locale, "guide.summary.h2")}</h2>
        <dl class="ledger">
          {
            summary.map((k) => (
              <div>
                <dt>{t(locale, `guide.summary.${k}`)}</dt>
                <dd>{t(locale, `guide.summary.${k}.value`)}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section aria-labelledby="ours">
        <h2 id="ours">{t(locale, "guide.ours.h2")}</h2>
        <p>{t(locale, "guide.ours.p1")}</p>
        <ul class="links">
          <li><a href={pagePath(locale, "security")}>{t(locale, "guide.ours.link")}</a></li>
        </ul>
      </section>
    </div>
  </div>
</Base>
