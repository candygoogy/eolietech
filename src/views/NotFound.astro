---
import Base from "../layouts/Base.astro";
import SeaContours from "../components/SeaContours.astro";
import Stamp from "../components/Stamp.astro";
import { t, localePath } from "../i18n";
import { pagePath } from "../i18n/routes";
import type { Locale } from "../tools/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Base locale={locale} title={t(locale, "notFound.title")} description={t(locale, "notFound.description")} noindex>
  <section class="container not-found">
    <div class="not-found__mark">
      <p class="not-found__code" aria-hidden="true">{t(locale, "notFound.code")}</p>
      <Stamp class="not-found__stamp" text={t(locale, "notFound.stamp")} sub={t(locale, "notFound.stamp.sub")} ink="ember" tilt={-4} land="load" />
    </div>
    <h1>{t(locale, "notFound.h1")}</h1>
    <p class="lede">{t(locale, "notFound.body")}</p>
    <div class="not-found__actions">
      <a class="btn btn--primary" href={localePath(locale)}>{t(locale, "notFound.back")}</a>
      <a class="link-strong" href={pagePath(locale, "tools")}>{t(locale, "notFound.tools")}</a>
    </div>
    <SeaContours />
  </section>
</Base>
